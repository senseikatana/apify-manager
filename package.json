{
  "name": "katanakit-js",
  "version": "2.12.2",
  "description": "KatanaKit — a sharp, framework-agnostic TypeScript service toolkit organized with hexagonal architecture.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express/index.d.ts",
      "import": "./dist/adapters/express/index.js",
      "default": "./dist/adapters/express/index.js"
    },
    "./adapters/nuxt": {
      "types": "./dist/adapters/nuxt/index.d.ts",
      "import": "./dist/adapters/nuxt/index.js",
      "default": "./dist/adapters/nuxt/index.js"
    },
    "./adapters/vue": {
      "types": "./dist/adapters/vue/index.d.ts",
      "import": "./dist/adapters/vue/index.js",
      "default": "./dist/adapters/vue/index.js"
    },
    "./adapters/astro": {
      "types": "./dist/adapters/astro/index.d.ts",
      "import": "./dist/adapters/astro/index.js",
      "default": "./dist/adapters/astro/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "yarn run src/adapters/express/main.ts",
    "start": "yarn run src/adapters/express/main.ts",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "yarn run check && yarn typecheck && yarn test",
    "compile": "tsc -p tsconfig.json",
    "build": "yarn validate && yarn compile",
    "prepublishOnly": "yarn build",
    "release:patch": "yarn build && yarn version --new-version patch && yarn publish --ignore-scripts",
    "release:minor": "yarn build && yarn version --new-version minor && yarn publish --ignore-scripts",
    "release:major": "yarn build && yarn version --new-version major && yarn publish --ignore-scripts",
    "docs:clear": "yarn --cwd docs clear",
    "docs:dev": "yarn --cwd docs start",
    "docs:build": "yarn validate && yarn docs:clear && yarn --cwd docs build",
    "docs:serve": "yarn --cwd docs serve"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:senseikatana/katanakit-js.git"
  },
  "keywords": [
    "api",
    "fetch",
    "http-client",
    "url-builder",
    "typescript",
    "hexagonal-architecture",
    "astro",
    "express",
    "nuxt",
    "vue",
    "singleton",
    "observer",
    "factory"
  ],
  "author": "senseikatana - Sergio Jurado",
  "license": "MIT",
  "bugs": {
    "url": "https://senseikatana.github.io/katanakit-js/issues"
  },
  "unpkg": "./dist/index.js",
  "jsdelivr": "./dist/index.js",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "peerDependencies": {
    "@prisma/orm-postgres": ">=8.0.0-rc.0",
    "cors": ">=2.8.0",
    "dotenv": ">=16.0.0",
    "express": ">=5.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/orm-postgres": {
      "optional": true
    },
    "cors": {
      "optional": true
    },
    "dotenv": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@prisma/cli-engine": "0.3.0",
    "@prisma/client": "^7.10.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "prisma": "8.0.0-rc.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.0"
  }
}
